VANTAGE_TELEMETRY_PORT=50224
DATABASE_URL=postgresql://vantage:vantage@localhost:5432/vantage_migration

# Required — the app refuses to start without a real value here (or
# VANTAGE_ALLOW_DEV_SECRETS=true below). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TELEMETRY_INTERNAL_KEY=
TELEMETRY_BRIDGE_JWT_SECRET=
# Set to true ONLY for a single-developer local run with no real secrets
# generated yet. Never set this in a shared/networked deployment.
# VANTAGE_ALLOW_DEV_SECRETS=true

GATEWAY_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:50223,http://localhost:50225

# Bootstrap admin on first run (split stack uses a separate DB from old monolith on :50123)
VANTAGE_ADMIN_USERNAME=admin
VANTAGE_ADMIN_PASSWORD=change-me

# Off by default: a shared key only proves the caller holds a valid
# credential, not which user/team it's acting as -- legacy auth trusts the
# caller's own X-User-Id/X-Team-Id headers for that. Only enable this for a
# migration window, and prefer per-user API tokens instead.
# VANTAGE_API_KEY=
# VANTAGE_LEGACY_API_KEY_ENABLED=true

# Optional overrides — defaults come from config/telemetry.config.json
# VANTAGE_UI_GOOGLE_CLIENT_ID=
# VANTAGE_UI_ALLOWED_EMAILS=you@example.com
# Allow email allowlist login alongside Google (useful until new ports are in GCP OAuth origins)
VANTAGE_UI_ALLOW_EMAIL_LOGIN=true
